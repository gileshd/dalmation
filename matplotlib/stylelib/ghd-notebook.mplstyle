# ghd notebook context
figure.figsize: 8.0, 5.5
axes.labelsize: 14
axes.titlesize: 16
xtick.labelsize: 12
ytick.labelsize: 12
legend.fontsize: 12

grid.linewidth: 1
lines.linewidth: 1.75
patch.linewidth: .3
lines.markersize: 7
lines.markeredgewidth: 0

xtick.major.width: 1
ytick.major.width: 1
xtick.minor.width: .5
ytick.minor.width: .5

xtick.major.pad: 7
ytick.major.pad: 7
