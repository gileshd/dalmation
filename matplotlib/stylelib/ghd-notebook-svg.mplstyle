# ghd notebook context for svg figures
# Use with %config InlineBackend.figure_format = 'svg'
figure.figsize: 6.5, 4.5
axes.labelsize: 12
axes.titlesize: 14
xtick.labelsize: 11
ytick.labelsize: 11
legend.fontsize: 11

grid.linewidth: 1
lines.linewidth: 1.75
patch.linewidth: .3
lines.markersize: 7
lines.markeredgewidth: 0

xtick.major.width: 1
ytick.major.width: 1
xtick.minor.width: .5
ytick.minor.width: .5

xtick.major.pad: 4
ytick.major.pad: 4
